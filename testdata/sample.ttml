<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    xmlns:smpte="http://www.smpte-ra.org/schemas/2052-1/2010/smpte-tt"
    xml:lang="en"
    ttp:frameRate="25"
    ttp:frameRateMultiplier="1 1"
    tts:extent="640px 360px">
  <head>
    <styling>
      <style xml:id="caption"
          tts:color="#fff4c2"
          tts:fontSize="30px"
          tts:textAlign="center"
          tts:displayAlign="after"
          tts:backgroundColor="rgba(5, 18, 35, 0.78)"
          tts:padding="8px 12px"/>
      <style xml:id="hidden-note"
          tts:display="none"
          tts:visibility="hidden"
          tts:opacity="0"/>
    </styling>
    <layout>
      <region xml:id="full" tts:origin="0% 0%" tts:extent="100% 100%"/>
      <region xml:id="captions" tts:origin="5% 72%" tts:extent="90% 22%" tts:showBackground="whenActive"/>
    </layout>
  </head>
  <body>
    <div xml:id="bg-a" begin="0s" end="3s" region="full"
        smpte:backgroundImage="data:image/png;base64,">
      <p xml:id="bg-a-label" begin="0s" end="3s" region="captions"
          style="caption">LAYER ONE / BACKGROUND IMAGE</p>
    </div>
    <div xml:id="bg-b" begin="3s" end="6s" region="full"
        smpte:backgroundImage="data:image/png;base64,">
      <p xml:id="bg-b-label" begin="0s" end="3s" region="captions"
          style="caption">LAYER TWO / SECOND BACKGROUND</p>
    </div>
    <p xml:id="note-hidden" role="annotation" begin="1s" end="5.5s"
        region="captions" style="hidden-note">HIDDEN ANNOTATION / MUST NOT RENDER</p>
    <!-- reviewer note: this XML comment is also a hidden annotation -->
  </body>
</tt>
